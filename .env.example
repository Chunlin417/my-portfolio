# This project currently has no required environment variables.
#
# Optional: base URL used for absolute Open Graph / Twitter card image URLs,
# the canonical link, sitemap.xml, and robots.txt (see lib/site.ts).
# Defaults to https://chunlin-he.vercel.app — only set this if you deploy
# somewhere else (a custom domain, or a preview environment you want indexed
# correctly). Must be prefixed with NEXT_PUBLIC_ because it is read in
# metadata that Next.js may serialize for the client.
NEXT_PUBLIC_SITE_URL=https://chunlin-he.vercel.app
