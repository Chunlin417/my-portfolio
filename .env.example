# This project currently has no required environment variables.
#
# Optional: base URL used for absolute Open Graph / Twitter card image URLs
# in app/layout.tsx metadata. The original index.html used a placeholder
# ("https://your-domain.com") — set this to your real deployed domain.
# Must be prefixed with NEXT_PUBLIC_ because it is read in metadata that
# Next.js may serialize for the client.
NEXT_PUBLIC_SITE_URL=https://your-domain.com
